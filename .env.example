NODE_ENV=local
APP_PORT=5004
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PostgreSQL (DATABASE_URL takes precedence when set)
DATABASE_URL=postgresql://postgres:password@localhost:5432/church_web
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=church_web
DATABASE_SSL_CONNECTION=false

# Set a long random value before using CMS write endpoints
ADMIN_API_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password-at-least-12-characters
TYPEORM_MIGRATIONS_RUN=false
MEDIA_UPLOAD_DIR=uploads
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
