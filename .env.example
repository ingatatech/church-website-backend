NODE_ENV=local
APP_PORT=5004
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PostgreSQL (DATABASE_URL takes precedence when set)
DATABASE_URL=postgresql://postgres:password@localhost:5432/church_web
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=church_web
DATABASE_SSL_CONNECTION=false

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Development writes verification messages as .eml files under var/mail.
# For production, set MAIL_TRANSPORT=smtp and provide SMTP_URL plus MAIL_FROM
# through the deployment environment or secret manager. Never put app passwords
# in this example file or commit them. URL-encode special characters in SMTP_URL.
# Gmail SMTP example format: smtp://user%40gmail.com:url-encoded-app-password@smtp.gmail.com:587
MAIL_TRANSPORT=file
MAIL_DIRECTORY=var/mail
MAIL_FROM=Church Website <no-reply@example.com>
# Example: smtp://username:url-encoded-password@smtp.example.com:587
SMTP_URL=

ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password-at-least-12-characters
TYPEORM_MIGRATIONS_RUN=false
MEDIA_UPLOAD_DIR=uploads
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional: set this if Cloudinary's secure_url uses a custom delivery hostname.
CLOUDINARY_DELIVERY_HOST=












